            "source": [
                "import requests\n",
                "import time\n",
                "\n",
                "# ====== إعدادات المستخدم ======\n",
                "VIDEO_URL = \"https://www.tiktok.com/@username/video/1234567890\"  # ضع رابط الفيديو هنا\n",
                "SERVICE_TYPE = \"views\"  # views, likes, shares, followers\n",
                "\n",
                "# ====== الدوال المساعدة ======\n",
                "def get_session():\n",
                "    headers = {\n",
                "        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',\n",
                "        'Accept-Language': 'en-US,en;q=0.9',\n",
                "    }\n",
                "    session = requests.Session()\n",
                "    session.headers.update(headers)\n",
                "    return session\n",
                "\n",
                "def solve_captcha(session):\n",
                "    print(\"🔐 محاولة الاتصال بـ zefoy.com...\")\n",
                "    try:\n",
                "        r = session.get('https://zefoy.com/', timeout=10)\n",
                "        if r.status_code == 200:\n",
                "            print(\"✅ تم الاتصال بنجاح\")\n",
                "            return True\n",
                "    except Exception as e:\n",
                "        print(f\"❌ فشل الاتصال: {e}\")\n",
                "    return False\n",
                "\n",
                "# ====== التشغيل ======\n",
                "print(\"🚀 بدء تشغيل البوت...\")\n",
                "session = get_session()\n",
                "\n",
                "if solve_captcha(session):\n",
                "    print(\"✅ الجلسة جاهزة للاستخدام\")\n",
                "    print(f\"🎯 الفيديو المستهدف: {VIDEO_URL}\")\n",
                "    print(f\"🔧 نوع الخدمة: {SERVICE_TYPE}\")\n",
                "else:\n",
                "    print(\"❌ تعذّر إنشاء الجلسة\")"
            ],

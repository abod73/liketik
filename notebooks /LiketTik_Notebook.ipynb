   "cell_type": "markdown",
   "metadata": {},
   "source": "---\n## 🛠️ الخطوة 3: إنشاء نسخة السكربت المعدّلة لبيئة Colab\n\nالسكربت الأصلي main.py يفتح نافذة متصفح مرئية ويعتمد على إدخال المستخدم مباشرةً في الموقع، وهذا غير ممكن في Colab.\nلذلك ننشئ نسخة معدّلة liketik_colab.py تقوم بما يلي:\n\n- تشغيل Chrome بوضع Headless (بدون واجهة رسومية) مع undetected-chromedriver.\n- التقاط صورة CAPTCHA وعرضها داخل الدفتر ثم سؤالك عن رمزها.\n- تحويل حلقة الإرسال المتكررة من استدعاء ذاتي (Recursion) إلى حلقة while آمنة.\n- معالجة فترات الانتظار (Cooldown) بين الإرسالات تلقائياً."
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": "%%writefile /content/liketikcolab.py\n# -*- coding: utf-8 -*-\n\"\"\"\nliketikcolab.py\n================\nنسخة معدّلة من سكربت مشروع liketik (https://github.com/abod73/liketik)\nللعمل على Google Colab بدون واجهة رسومية (Headless)،\nمع عرض صورة التحقق CAPTCHA داخل الدفتر وإدخال رمزها يدوياً.\n\nطريقة التشغيل داخل Colab:\n    %run liketikcolab.py\n\"\"\"\n\nimport os\nimport re\nimport sys\nimport time\nimport shutil\n\ntry:\n    import undetectedchromedriver as uc\n    from colorama import Fore, init\n    import selenium\n    from selenium.webdriver.common.by import By\n    from selenium.webdriver.support.ui import WebDriverWait\n    from selenium.webdriver.support import expectedconditions as EC\n    from selenium.common.exceptions import NoSuchElementException, TimeoutException\nexcept ImportError as e:\n    print(\"إحدى المكتبات المطلوبة غير مثبتة:\", e)\n    print(\"نفّذ خلية التثبيت أولاً: pip install -U undetected-chromedriver selenium colorama requests\")\n    sys.exit(1)\n\n# عرض الصور داخل الدفتر (يعمل عند التشغيل عبر %run)\ntry:\n    from IPython.display import display, Image as NBImage\n    INNOTEBOOK = True\nexcept Exception:\n    INNOTEBOOK = False\n\ninit(autoreset=True)\n\nBANNER = \"\"\"\n ██╗     ██╗██╗  ██╗███████╗████████╗██╗████████╗\n ██║     ██║██║ ██╔╝██╔════╝╚══██╔══╝██║╚══██╔══╝\n ██║     ██║█████╔╝ █████╗     ██║   ██║   ██║\n ██║     ██║██╔═██╗ ██╔══╝     ██║   ██║   ██║\n ███████╗██║██║  ██╗███████╗   ██║   ██║   ██║\n ╚══════╝╚═╝╚═╝  ╚═╝╚══════╝   ╚═╝   ╚═╝   ╚═╝\n   LikeTik on Colab  ~  based on zefoy.com (@xtekky style)\n\"\"\"\n\nMENU = [\"followers\", \"hearts\", \"commenthearts\", \"views\", \"shares\", \"favorites\"]\n\n\nclass ZefoyColab:\n\n    def init(self):\n        print(Fore.CYAN + \"[] جارٍ تشغيل المتصفح (Chrome Headless)...\")\n        self.driver = self.build_driver()\n        self.captcha_form_xpath = '/html/body/div[5]/div[2]/form'\n        self.captcha_box_xpath = '/html/body/div[5]/div[2]/form/div/div'\n        self.sent = 0\n        self.xpaths = {\n            \"followers\":      \"/html/body/div[6]/div/div[2]/div/div/div[2]/div/button\",\n            \"hearts\":         \"/html/body/div[6]/div/div[2]/div/div/div[3]/div/button\",\n            \"comment_hearts\": \"/html/body/div[6]/div/div[2]/div/div/div[4]/div/button\",\n            \"views\":          \"/html/body/div[6]/div/div[2]/div/div/div[5]/div/button\",\n            \"shares\":         \"/html/body/div[6]/div/div[2]/div/div/div[6]/div/button\",\n            \"favorites\":      \"/html/body/div[6]/div/div[2]/div/div/div[7]/div/button\",\n        }\n\n    # ---------------- المتصفح ----------------\n    def build_driver(self):\n        options = uc.ChromeOptions()\n        options.add_argument(\"--no-sandbox\")\n        options.add_argument(\"--disable-dev-shm-usage\")\n        options.add_argument(\"--disable-gpu\")\n        options.add_argument(\"--lang=en-US\")\n        options.add_argument(\"--window-size=1366,1900\")\n        options.add_argument(\n            \"user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) \"\n            \"AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36\"\n        )\n\n        chrome_bin = (\n            shutil.which(\"google-chrome\")\n            or shutil.which(\"google-chrome-stable\")\n            or shutil.which(\"chromium\")\n            or shutil.which(\"chromium-browser\")\n        )\n        kwargs = {\"options\": options}\n        if chrome_bin:\n            kwargs[\"browser_executable_path\"] = chrome_bin\n\n        try:\n            return uc.Chrome(headless=True, kwargs)\n        except TypeError:\n            options.add_argument(\"--headless=new\")\n            return uc.Chrome(kwargs)\n\n    # ---------------- أدوات مساعدة ----------------\n    def find(self, xpath, timeout=20):\n        return WebDriverWait(self.driver, timeout).until(\n            EC.presence_of_element_located((By.XPATH, xpath))\n        )\n\n    def exists(self, xpath):\n        try:\n            self.driver.find_element(By.XPATH, xpath)\n            return True\n        except NoSuchElementException:\n            return False\n\n    def find_captcha_form(self):\n        try:\n            return self.find(self.captcha_form_xpath, timeout=12)\n        except TimeoutException:\n            for form in self.driver.find_elements(By.TAG_NAME, \"form\"):\n                try:\n                    if form.find_elements(By.TAG_NAME, \"img\") and form.find_elements(By.TAG_NAME, \"input\"):\n                        return form\n                except Exception:\n                    continue\n        return None\n\n    def show_captcha(self):\n        path = \"/content/zefoy_captcha.png\"\n        try:\n            self.find(self.captcha_box_xpath, timeout=15).screenshot(path)\n        except Exception:\n            try:\n                form = self.find_captcha_form()\n                imgs = form.find_elements(By.TAG_NAME, \"img\") if form else []\n                if imgs:\n                    imgs[0].screenshot(path)\n                else:\n                    self.driver.save_screenshot(path)\n            except Exception:\n                self.driver.save_screenshot(path)\n\n        print(Fore.YELLOW + \"[!] صورة التحقق CAPTCHA:\")\n        if IN_NOTEBOOK:\n            display(NBImage(filename=path))\n        else:\n            print(\"الصورة محفوظة في:\", path)\n\n    # ---------------- حل CAPTCHA ----------------\n    def solve_captcha(self, max_attempts=8):\n        for attempt in range(1, max_attempts + 1):\n            form = self.find_captcha_form()\n            if form is None:\n                print(Fore.YELLOW + \"[!] نموذج CAPTCHA غير موجود، جارٍ إعادة تحميل الصفحة...\")\n                self.driver.get(\"https://zefoy.com\")\n                time.sleep(6)\n                continue\n\n            self.show_captcha()\n            code = input(f\"[المحاولة {attempt}] أدخل رمز التحقق الظاهر في الصورة أعلاه: \").strip()\n\n            try:\n                target = None\n                for el in form.find_elements(By.TAG_NAME, \"input\"):\n                    t = (el.get_attribute(\"type\") or \"text\").lower()\n                    if t in (\"text\", \"search\", \"\") and el.is_displayed():\n                        target = el\n                        break\n                if target is None:\n                    inputs = form.find_elements(By.TAG_NAME, \"input\")\n                    target = inputs[-1] if inputs else None\n\n                if target is not None:\n                    target.clear()\n                    target.send_keys(code)\n                    buttons = form.find_elements(By.TAG_NAME, \"button\")\n                    if buttons:\n                        buttons[-1].click()\n                    else:\n                        target.submit()\n            except Exception as e:\n                print(Fore.RED + \"تعذّر إدخال رمز التحقق:\", e)\n\n            time.sleep(4)\n\n            try:\n                self.find(self.xpaths[\"followers\"], timeout=12)\n                print(Fore.GREEN + \"[✔] تم قبول رمز التحقق بنجاح.\")\n                return True\n            except TimeoutException:\n                print(Fore.RED + \"[x] رمز التحقق غير صحيح، ستتم إعادة المحاولة...\")\n                self.driver.get(\"https://zefoy.com\")\n                time.sleep(6)\n\n        raise RuntimeError(\"فشل تجاوز CAPTCHA بعد عدة محاولات.\")\n\n    # ---------------- حالة الخدمات ----------------\n    def check_status(self):\n        statuses = {}\n        for key, xp in self.xpaths.items():\n            try:\n                element = self.driver.find_element(By.XPATH, xp)\n                if element.is_enabled():\n                    statuses[key] = Fore.GREEN + \"[WORKS]\"\n                else:\n                    statuses[key] = Fore.RED + \"[OFFLINE]\"\n            except NoSuchElementException:\n                statuses[key] = Fore.RED + \"[NOT FOUND]\"\n        return statuses\n\n    # ---------------- واجهة الاستخدام ----------------\n    def main(self):\n        print(Fore.CYAN + BANNER)\n        print(\"[] جارٍ فتح موقع zefoy.com ... (ظهور خطأ 502 يعني أن عنوان IP محجوب)\")\n        self.driver.get(\"https://zefoy.com\")\n        time.sleep(6)\n\n        if self.exists(self.xpaths[\"followers\"]):\n            print(Fore.GREEN + \"[✔] تم تحميل الموقع بدون CAPTCHA.\")\n        else:\n            self.solvecaptcha()\n\n        status = self.checkstatus()\n        print(Fore.CYAN + \"\\nالخدمات المتاحة:\")\n        for i, key in enumerate(MENU, 1):\n            print(f\"  [{i}] {key}  {status.get(key, '')}\")\n\n        raw = input(\"\\nاختر رقم الخدمة (1-6): \").strip()\n        if not raw.isdigit() or not 1 = 2:\n                total = int(nums[0])  60 + int(nums[1])\n            elif nums:\n                total = int(nums[0])\n            return total + 5, txt\n\n        return None, txt\n\n    def cooldown(self, seconds):\n        seconds = int(seconds)\n        print(Fore.YELLOW + f\"[] فترة انتظار {seconds} ثانية قبل الإرسال التالي...\")\n        while seconds > 0:\n            print(f\"\\rالمتبقي: {seconds} ثانية   \", end=\"\")\n            time.sleep(1)\n            seconds -= 1\n        print(\"\\r\" + \" \" * 35 + \"\\r\", end=\"\")\n\n    def runbot(self, div, vid):\n        urlbox = f\"/html/body/div[{div}]/div/form/div/input\"\n        searchbtn = f\"/html/body/div[{div}]/div/form/div/div/button\"\n        sendbtn = f\"/html/body/div[{div}]/div/div/div[1]/div/form/button\"\n\n        while True:\n            try:\n                el = self.find(urlbox, timeout=20)\n                el.clear()\n                el.sendkeys(vid)\n                self.driver.findelement(By.XPATH, searchbtn).click()\n                time.sleep(3)\n\n                waits, info = self.checksubmit(div)\n                if info and \"(s)\" in str(info) and waits:\n                    self.cooldown(waits)\n                    self.driver.findelement(By.XPATH, searchbtn).click()\n                    time.sleep(2)\n\n                time.sleep(3)\n                try:\n                    self.driver.findelement(By.XPATH, sendbtn).click()\n                except NoSuchElementException:\n                    print(Fore.RED + \"[!] زر الإرسال غير متوفر — الخدمة قد تكون مشغولة أو الرابط غير صالح.\")\n                    time.sleep(10)\n                    continue\n\n                self.sent += 1\n                print(Fore.GREEN + f\"[+] تم الإرسال رقم {self.sent} بنجاح.\")\n                time.sleep(4)\n\n            except KeyboardInterrupt:\n                print(f\"\\nتم الإيقاف. إجمالي الإرسالات: {self.sent}\")\n                break\n            except Exception as e:\n                print(Fore.RED + f\"[!] خطأ: {e} — إعادة المحاولة بعد 5 ثوانٍ...\")\n                time.sleep(5)\n\n\nif name == \"main\":\n    bot = ZefoyColab()\n    try:\n        bot.main()\n    except KeyboardInterrupt:\n        print(\"\\nتم الإيقاف بواسطة المستخدم.\")\n    except Exception as err:\n        print(Fore.RED + \"حدث خطأ:\", err)\n    finally:\n        try:\n            bot.driver.quit()\n        except Exception:\n            pass\n",
   "execution_count": null,
   "outputs": []
  },
